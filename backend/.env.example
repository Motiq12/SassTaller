# Copia este archivo a ".env" y ajusta los valores
PORT=3000

# --- Conexion MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=proyecto_taller

# Origen permitido para CORS (el frontend de Ionic)
CORS_ORIGIN=http://localhost:8100

# --- Seguridad ---
# Secreto para firmar/verificar los JWT. OBLIGATORIO en producción (el server
# aborta si falta). Usá una cadena larga y aleatoria.
JWT_SECRET=
# Vida del token (opcional, por defecto 8h).
JWT_EXPIRES_IN=8h

# --- Cuentas semilla (solo para "npm run migrate") ---
# Sin estas contraseñas, el seed NO crea las cuentas (evita credenciales conocidas).
# Definilas con valores fuertes (mín. 8 caracteres) solo para el bootstrap inicial.
SEED_ADMIN_EMAIL=admin@taller.com
SEED_ADMIN_PASSWORD=
SEED_RECEP_EMAIL=recepcion@taller.com
SEED_RECEP_PASSWORD=

# --- Correo (Resend) para recuperación de contraseña ---
# Sin RESEND_API_KEY, el código se imprime en consola (modo desarrollo).
# Con onboarding@resend.dev solo se entrega a tu propia casilla verificada;
# para enviar a clientes reales verificá un dominio en Resend.
RESEND_API_KEY=
MAIL_FROM=Taller MS <onboarding@resend.dev>

# --- Respaldo automático de la base (opcional, pero recomendado en producción) ---
# Todas las noches (08:30 UTC) el sistema vuelca la base, la comprime y la sube a
# un almacenamiento compatible con S3 (un bucket de Railway, Cloudflare R2, etc.).
# Con las cuatro primeras definidas, queda encendido. Ver docs/RESPALDOS.md.
RESPALDO_S3_ENDPOINT=
RESPALDO_S3_BUCKET=
RESPALDO_S3_ACCESS_KEY_ID=
RESPALDO_S3_SECRET_ACCESS_KEY=
# Región para la firma (por defecto "auto", que es la de Railway y R2).
RESPALDO_S3_REGION=auto
# "virtual" (por defecto): https://<bucket>.<endpoint>/…   "path": https://<endpoint>/<bucket>/…
RESPALDO_S3_ESTILO=virtual
# Carpeta dentro del bucket y cuántos respaldos se conservan (uno por día).
RESPALDO_PREFIJO=respaldos/
RESPALDO_CONSERVAR=14
# Frase para cifrar los respaldos antes de subirlos. Si está vacía, suben sin
# cifrar. Guardala TAMBIÉN fuera de Railway: sin ella no se pueden abrir.
RESPALDO_CLAVE=

# Vigilante de n8n: clave para leer GET /api/monitor/seguridad (logins fallidos,
# cambios de rol, estado del respaldo). Mínimo 32 caracteres; sin ella la ruta no
# existe. Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MONITOR_CLAVE=
