# Copia este archivo a ".env" y ajusta los valores
PORT=3000

# --- Conexión Postgres ---
# En Railway alcanza con DATABASE_URL (se referencia desde el servicio de Postgres) y
# las DB_* se ignoran. En local, el contenedor de desarrollo es:
#   docker run -d --name motiq-pg -e POSTGRES_USER=motiq -e POSTGRES_PASSWORD=motiq_dev \
#     -e POSTGRES_DB=sasstaller -p 5432:5432 -v motiq-pg18-data:/var/lib/postgresql postgres:18-alpine
# DATABASE_URL=postgres://usuario:clave@host:5432/sasstaller
# En producción la app NO se conecta como dueña del esquema (ver db/README.md): las
# migraciones usan esta otra conexión. Sin ella, se migra con DATABASE_URL / DB_*.
# MIGRACION_DATABASE_URL=postgres://dueño:clave@host:5432/sasstaller
DB_HOST=localhost
DB_PORT=5432
DB_USER=motiq
DB_PASSWORD=motiq_dev
DB_NAME=sasstaller

# Origen permitido para CORS (el frontend de Ionic)
CORS_ORIGIN=http://localhost:8100

# --- Seguridad ---
# Secreto para firmar/verificar los JWT. OBLIGATORIO en producción (el server
# aborta si falta). Usá una cadena larga y aleatoria.
JWT_SECRET=
# Vida del token (opcional, por defecto 8h).
JWT_EXPIRES_IN=8h

# --- Correo (Resend) para recuperación de contraseña ---
# Sin RESEND_API_KEY, el código se imprime en consola (modo desarrollo).
# Con onboarding@resend.dev solo se entrega a tu propia casilla verificada;
# para enviar a clientes reales verificá un dominio en Resend.
RESEND_API_KEY=
MAIL_FROM=Motiq <onboarding@resend.dev>
